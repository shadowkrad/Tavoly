generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Area {
  id          String   @id @default(cuid())
  name        String   // es. "Sala Interna", "Dehors Giardino", "Terrazza Panoramica"
  description String?
  orderIndex  Int      @default(0)
  tables      Table[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Table {
  id           String        @id @default(cuid())
  number       String        // es. "1", "12", "D1", "T4"
  capacity     Int           @default(2)
  seatedCount  Int           @default(0)        // numero persone effettivamente sedute per i pallini grafici
  status       String        @default("LIBERO") // LIBERO, OCCUPATO, PRENOTATO, CONTO, DA_PULIRE
  shape        String        @default("RECTANGLE") // RECTANGLE, ROUND, BAR
  posX         Float         @default(50)       // posizione percentuale X sulla lavagna (0-100)
  posY         Float         @default(50)       // posizione percentuale Y sulla lavagna (0-100)
  areaId       String
  area         Area          @relation(fields: [areaId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([areaId, number])
}

model Reservation {
  id          String    @id @default(cuid())
  customerName String
  phoneNumber String
  email       String?
  guestCount  Int       @default(2)
  timeSlot    String    // es. "12:30", "13:15", "20:00", "21:30"
  date        DateTime  @default(now())
  status      String    @default("CONFERMATA") // IN_ATTESA, CONFERMATA, SEDUTI, COMPLETATA, ANNULLATA
  notes       String?   // es. "Allergia glutine, tavolo vista giardino"
  tableId     String?
  table       Table?    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  whatsappSent Boolean  @default(false)
  isWalkIn    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model LocalSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ServiceShift {
  id                 String   @id @default(cuid())
  name               String   // es. "Pranzo", "Aperitivo al Bar", "Cena 1° Turno", "Cena 2° Turno"
  timeSlotsJson      String   // JSON string di orari, es. '["12:30","13:00","13:30"]'
  maxGuests          Int      @default(50)
  avgDurationMinutes Int      @default(90)
  isActive           Boolean  @default(true)
  orderIndex         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model CustomerProfile {
  id            String   @id @default(cuid())
  phoneNumber   String   @unique
  name          String
  email         String?
  allergies     String?  // Intolleranze / allergeni segnalati (es. "Celiachia (Senza Glutine)")
  favoriteTable String?  // Tavolo o zona preferita (es. "Tavolo 4", "Dehors Vista Giardino")
  isVip         Boolean  @default(false)
  notes         String?  // preferenze, ricorrenze, note di sala
  visitCount    Int      @default(1)
  loyaltyPoints Int      @default(10)
  lastVisitAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TakeawayOrder {
  id            String   @id @default(cuid())
  customerName  String
  phoneNumber   String
  pickupTime    String   // es. "19:45"
  itemsSummary  String   // es. "2x Spritz, 1x Tagliere Misto, 2x Burger Gourmet"
  totalAmount   Float    @default(0.0)
  status        String   @default("IN_CODA") // IN_CODA, IN_PREPARAZIONE, PRONTO, RITIRATO, ANNULLATO
  paymentStatus String   @default("DA_PAGARE") // DA_PAGARE, PAGATO
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Dispositivi PWA FIDO2 / Biometrici autorizzati per avvio rapido con PIN/Impronta (es. palmari camerieri o smartphone titolare)
model RegisteredDevice {
  id           String    @id @default(cuid())
  deviceName   String    // Es. "Palmare Cameriere Sala 1", "iPhone Titolare"
  deviceType   String    @default("mobile") // mobile, tablet, desktop
  credentialId String    @unique // ID univoco generato dal chip hardware Secure Enclave
  publicKey    String    // Chiave pubblica FIDO2 codificata base64url
  counter      BigInt    @default(0) // Contatore anti-clonazione
  transports   String    @default("[]") // internal, usb, ble, nfc (JSON string)
  status       String    @default("ACTIVE") // ACTIVE | REVOKED
  lastUsedAt   DateTime?
  lastIp       String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

// Sfide crittografiche monouso per registrazione e login WebAuthn
model WebAuthnChallenge {
  challenge String   @id
  type      String   // registration | authentication
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Menù Digitale Ristorante
model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float    @default(0.0)
  category    String   // es. "Antipasti", "Primi", "Secondi", "Contorni", "Dolci", "Pizze", "Bevande"
  allergens   String   @default("[]") // JSON string array es. '["Glutine","Latticini"]'
  imageUrl    String?  // URL fotografia del piatto
  isAvailable Boolean  @default(true) // disponibile o esaurito
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

